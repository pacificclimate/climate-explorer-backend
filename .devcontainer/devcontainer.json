// For format details, see https://aka.ms/devcontainer.json. For config options, see the README at:
// https://github.com/microsoft/vscode-dev-containers/tree/v0.245.0/containers/python-3
{
  "name": "Python3 & Poetry & Postgres",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
    }
  },
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {
        "remote.autoForwardPorts": false,
        // The project is installed into the base image's prebuilt virtualenv
        // (see .devcontainer/post-install.sh), which also provides black via
        // the project's dev extras.
        "python.defaultInterpreterPath": "/opt/venv/bin/python",
        "python.formatting.provider": "black",
        "python.formatting.blackPath": "/opt/venv/bin/black"
      },
      // VSCODE ONLY: Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ]
    }
  },
  // Use 'forwardPorts' to make a list of ports inside the container available locally.
  //"forwardPorts": [48423],
  // Use 'postCreateCommand' to run commands after the container is created.
  "postCreateCommand": "bash ./.devcontainer/post-install.sh",
  "postStartCommand": "bash ./.devcontainer/post-start.sh",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      // The base image is Ubuntu 26.04 ("resolute"), which has no moby-cli /
      // moby-engine packages. Install Docker CE from Docker's official apt repo
      // instead of the open-source moby build.
      "moby": false
    }
    // The "git" feature was removed: it adds the git-core PPA, which has no
    // release for Ubuntu 26.04 ("resolute"), so apt rejects it as unsigned.
    // git is already installed via apt in the Dockerfile.
  },
  // Comment out to connect as root instead. More info: https://aka.ms/vscode-remote/containers/non-root.
  "remoteUser": "vscode",
  "remoteEnv": {
    //		"PATH": "${containerEnv:PATH}:${containerEnv:HOME}/.local/bin"
  },
  "runArgs": [
    // allow container to be treated with no network isolation
    "--network=host",
    // give a nicer name to the container
    "--name",
    "pcex_backend_devcontainer_${localEnv:USER}",
    // Optionally persist Claude Code state (conversation history, file history,
    // login credentials) across container rebuilds by bind-mounting the host's
    // ~/.claude. This is a "-v" mount (not a "mounts" entry) on purpose: if the
    // host directory does not exist it is auto-created rather than failing the
    // container start, so it stays optional. To disable, remove the two lines
    // below.
    "-v",
    "${localEnv:HOME}/.claude:/home/vscode/.claude",
    // Also persist ~/.claude.json, which lives OUTSIDE the ~/.claude directory
    // and is therefore not covered by the mount above. It holds login/OAuth, MCP
    // server config, folder-trust, and per-project prompt history, so without
    // this mount that state resets on every rebuild. NOTE: for a single-file bind
    // mount the host file must already exist (otherwise Docker creates a
    // directory in its place) -- run `touch ~/.claude.json` on the host once if
    // needed. To disable, remove the two lines below.
    "-v",
    "${localEnv:HOME}/.claude.json:/home/vscode/.claude.json"
  ],
  "mounts": [
    "source=/storage/data/projects/comp_support/daccs/test-data/,target=/storage/data/projects/comp_support/daccs/test-data/,type=bind,consistency=cached"
  ]
}